# loose.ai server environment. Copy to `.env` and fill in values.
# Validated at boot by src/config/env.ts — the server refuses to start on bad config.

NODE_ENV=development
PORT=4000
# Web app origin (OAuth redirects land here) and the public API origin.
APP_URL=http://localhost:5173
API_URL=http://localhost:4000
# Number of trusted reverse-proxy hops (0 = none). Needed for correct client IPs.
TRUST_PROXY=0
# Production refuses TRUST_PROXY>0 unless you confirm the API is only reachable through that many
# proxies that overwrite X-Forwarded-For (a shorter/direct path could spoof the client IP).
# TRUST_PROXY_HOPS_ACKNOWLEDGED=true

DATABASE_URL=postgresql://loose:loose@127.0.0.1:5432/loose
REDIS_URL=redis://127.0.0.1:6379

# >= 32 chars. Generate: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=

# Envelope encryption. `local` wraps data keys with LOCAL_KMS_MASTER_KEY; `aws` is not implemented yet.
KMS_PROVIDER=local
# base64 of exactly 32 random bytes. Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
LOCAL_KMS_MASTER_KEY=
# KMS_KEY_ID=

# OAuth apps (optional; when missing, /auth/<provider> answers LSE-AUTH-004).
# Callback URLs: ${API_URL}/api/v1/auth/google/callback and ${API_URL}/api/v1/auth/github/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_WEBHOOK_SECRET=

# ---- Phase 9 triggers (optional) ---------------------------------------------------------
# Each inbound integration is disabled (503 LSE-SYS-007) until its secret is set.
# Slack app "Signing Secret" for the slash command (Request URL: ${API_URL}/api/v1/integrations/slack/commands)
SLACK_SIGNING_SECRET=
# DEPRECATED / UNUSED (P10-SEC-007): Linear and Jira are credentialed per trigger — the
# trigger's webhook URL carries an unguessable token and its signing secret is derived per
# trigger (both shown with the trigger in Org Settings). These two variables are ignored.
LINEAR_WEBHOOK_SECRET=
JIRA_WEBHOOK_SECRET=

# DEV ONLY: enables POST /api/v1/auth/dev-login. Ignored when NODE_ENV=production.
DEV_LOGIN_ENABLED=false

DEFAULT_MAX_BUDGET_USD=5
DEFAULT_MAX_SESSION_MIN=60

# Optional rate-limit overrides (requests per minute).
# RATE_LIMIT_AUTH_MAX=20
# RATE_LIMIT_KEY_VALIDATION_MAX=10
# RATE_LIMIT_GENERAL_MAX=300
# RATE_LIMIT_SESSION_CREATE_MAX=10

LOG_LEVEL=info

# ---- GitHub App (optional) ------------------------------------------------------------
# Preferred over user OAuth tokens for clone/push (short-lived, repo-scoped installation tokens).
# The private key may be given on one line with literal \n sequences.
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY=

# ---- Sandboxes (Phases 3–4) ---------------------------------------------------------------
# e2b | local | fake. Default: e2b in production, local in development, fake in tests.
# `local` is DEV ONLY and UNSAFE: commands run on this machine without isolation
# (it is rejected when NODE_ENV=production).
SANDBOX_PROVIDER=
# Required when SANDBOX_PROVIDER=e2b (production refuses to start without it).
E2B_API_KEY=
# E2B_DOMAIN=
# DEV ONLY: use the local provider when SANDBOX_PROVIDER=e2b but E2B_API_KEY is empty.
LOCAL_SANDBOX_ALLOW_FALLBACK=false
# DEV ONLY: where local sandboxes live (default: <os tmpdir>/loose-sandboxes).
# LOCAL_SANDBOX_DIR=
# DEV ONLY: runner entry for local sandboxes (default: ../../packages/runner/dist/cli.js from apps/server).
# LOCAL_RUNNER_ENTRY=
# Alias of LOCAL_RUNNER_ENTRY (takes precedence). Build first: bun run --cwd packages/runner build
# RUNNER_ENTRY=
# DEV ONLY: clone/push from a local path instead of github.com, e.g. /tmp/loose-remotes/{owner}/{repo}.git
# (ignored and rejected in production).
# DEV_GIT_REMOTE_OVERRIDE=
# Sandbox lifetime (extended by keep-alive while the session is active) and per-command timeout.
SANDBOX_TIMEOUT_MIN=30
SANDBOX_COMMAND_TIMEOUT_SEC=600
# Base delay of the jittered retries around sandbox provider calls.
SANDBOX_RETRY_BASE_MS=500
TEMPLATE_BUILD_TIMEOUT_MIN=30
# Built runner bundle copied into e2b templates (/sandbox-agent/runner/dist), e.g. ../../packages/runner/dist
# RUNNER_BUNDLE_DIR=
# Deterministic mock agent (no Anthropic calls). Default: true unless SANDBOX_PROVIDER=e2b.
# RUNNER_MOCK=true
# Before/after preview screenshots per turn (needs Chromium in the sandbox). Default: true only with e2b.
# AGENT_SCREENSHOTS=

# ---- Jobs & artifacts ---------------------------------------------------------------------
# Run queue jobs in-process (default: true outside production). In production set false and
# run the worker: `bun run --cwd apps/server start:worker`.
# JOBS_INLINE=true
# local | s3. Use s3 (or MinIO) for multi-instance / production deployments.
ARTIFACT_STORAGE=local
ARTIFACT_DIR=./.data/artifacts
# ---- S3 / MinIO (required: S3_BUCKET when ARTIFACT_STORAGE=s3) ---------------------------
# Local MinIO: `docker compose --profile storage up -d minio`, then e.g.
#   S3_BUCKET=loose-artifacts S3_ENDPOINT=http://127.0.0.1:9000 S3_FORCE_PATH_STYLE=true
# S3_BUCKET=
# S3_REGION=us-east-1
# S3_ENDPOINT=
# Both or neither (otherwise the default AWS credential chain is used).
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_FORCE_PATH_STYLE=false
# S3_PREFIX=
# S3_SIGNED_URL_TTL_SEC=300

# ---- Identity (Phase 10): SSO, SCIM, 2FA ---------------------------------------------------
# Issuer label shown in authenticator apps.
# TOTP_ISSUER=loose.ai
# Timeout of OIDC discovery / JWKS / token requests.
# SSO_HTTP_TIMEOUT_MS=5000

# ---- Governance (Phase 10): audit chain, retention, GDPR/DPDP ------------------------------
# HMAC key of the tamper-evident audit chain (>= 32 chars). Defaults to a key derived from
# SESSION_SECRET; set a dedicated value in production so rotating SESSION_SECRET keeps the
# chain verifiable.
# AUDIT_CHAIN_SECRET=
# Grace period between an account/org deletion request and its execution (0-90 days).
# DELETION_GRACE_DAYS=30
# How long a data export stays downloadable.
# DATA_EXPORT_TTL_HOURS=72

# ---- Observability & operations (Phase 10) --------------------------------------------------
# Stable process id (default: <hostname>-<pid>-<random>).
# INSTANCE_ID=
# Feature flags: comma list of flag=on|off (see FEATURE_FLAGS in packages/shared/src/hardening.ts),
# e.g. sso_saml=off,plugins=on. Unknown names refuse to boot.
# FEATURE_FLAGS=
# Prometheus: either protect /metrics on the main port with a bearer token (>= 32 chars) ...
# METRICS_TOKEN=
# ... and/or serve it on a separate internal listener (API and worker).
# METRICS_PORT=9464
# METRICS_HOST=127.0.0.1
# A non-loopback METRICS_HOST requires METRICS_TOKEN (the listener then demands a Bearer token).
# /readyz also checks e2b reachability (default: true when SANDBOX_PROVIDER=e2b).
# READYZ_CHECK_E2B=
# Reserved: OpenTelemetry export is not wired yet (trace context is propagated via traceparent).
# OTEL_EXPORTER_OTLP_ENDPOINT=
