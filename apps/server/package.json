{
  "name": "@loose/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/index.ts",
    "build": "tsup src/index.ts src/worker.ts --format esm --target node22 --clean",
    "start": "node --env-file-if-exists=.env dist/index.js",
    "start:worker": "node --env-file-if-exists=.env dist/worker.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src test",
    "test": "vitest run",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:deploy": "prisma migrate deploy"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1152.0",
    "@aws-sdk/s3-request-presigner": "3.1152.0",
    "@loose/shared": "workspace:*",
    "@octokit/auth-app": "8.3.1",
    "@octokit/rest": "22.0.1",
    "@prisma/client": "6.19.3",
    "bullmq": "5.81.5",
    "cookie-parser": "1.4.7",
    "e2b": "2.52.0",
    "express": "5.2.1",
    "express-rate-limit": "8.7.0",
    "fflate": "0.8.3",
    "helmet": "8.3.0",
    "ioredis": "5.11.1",
    "nanoid": "5.1.16",
    "picomatch": "4.0.7",
    "pino": "9.14.0",
    "pino-http": "10.5.0",
    "rate-limit-redis": "4.3.1",
    "ws": "8.22.0",
    "yaml": "2.9.1",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/cookie-parser": "1.4.10",
    "@types/express": "5.0.6",
    "@types/node": "22.20.4",
    "@types/picomatch": "4.0.3",
    "@types/supertest": "6.0.3",
    "@types/ws": "8.18.2",
    "msw": "2.15.0",
    "pino-pretty": "13.1.3",
    "prisma": "6.19.3",
    "supertest": "7.3.0",
    "tsup": "8.5.1",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vitest": "4.1.11"
  }
}
